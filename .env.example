# Optional configuration. The site works with every value below left empty.
# Copy public tracking values to .env for local Astro development.
# Keep private API credentials in a gitignored .env.local or deployment secrets.

# Site origin and path are supplied by GitHub Pages during deployment.
# For local builds, export these in your shell before running npm run build.
# Example: SITE_URL=https://username.github.io BASE_PATH=/website/ npm run build
SITE_URL=
BASE_PATH=

# Option A: private dashboard with Cloudflare Web Analytics.
# This beacon token is a public site identifier, not a Cloudflare API key.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Option B: Umami tracker, with an optional public visitor/country summary.
# Copy the script URL from your Umami installation settings.
# Umami Cloud commonly uses https://cloud.umami.is/script.js.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=

# Optional Umami Cloud API sync. This key must NEVER have a PUBLIC_ prefix.
# In GitHub, store UMAMI_API_KEY under Actions secrets, not variables.
UMAMI_API_KEY=
# Optional: defaults to PUBLIC_UMAMI_WEBSITE_ID.
UMAMI_WEBSITE_ID=
# Optional: us or eu; leave blank for the account default.
UMAMI_API_REGION=

# Optional local browser-test override.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
