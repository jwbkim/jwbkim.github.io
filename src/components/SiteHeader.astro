---
interface Props { page: 'main' | 'personal'; }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="header-inner">
    <nav aria-label="Main navigation">
      <a href={base} aria-current={page === 'main' ? 'page' : undefined}>Main</a>
      <a href={`${base}personal/`} aria-current={page === 'personal' ? 'page' : undefined}>Personal</a>
    </nav>
  </div>
</header>
