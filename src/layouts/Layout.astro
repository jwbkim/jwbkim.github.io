---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Ji Woong (Brian) Kim · Robot Learning · Stanford', description = 'Ji Woong (Brian) Kim is a postdoctoral researcher at Stanford University working on robot learning, dexterous manipulation, and general-purpose robots.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const cloudflareToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const hasUmami = Boolean(umamiId && umamiScript);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Ji Woong Kim', alternateName: 'Brian Kim', jobTitle: 'Postdoctoral Researcher', affiliation: { '@type': 'CollegeOrUniversity', name: 'Stanford University' }, email: 'jwbkim@stanford.edu', ...(Astro.site ? {url: Astro.site.href} : {}), sameAs: ['https://scholar.google.com/citations?user=Z_lj4yMAAAAJ'] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(`${base}media/portrait.webp`, Astro.site)} /></>}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    {cloudflareToken && !hasUmami && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token: cloudflareToken})}></script>}
    {hasUmami && <script is:inline defer src={umamiScript} data-website-id={umamiId}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
