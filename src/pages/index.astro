---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProfileIcon from '../components/ProfileIcon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ResearchFeature from '../components/ResearchFeature.astro';
import VisitorStats from '../components/VisitorStats.astro';
import { profile, projects } from '../data/profile';
import { news } from '../data/news';
import { publications } from '../data/publications';
const base = import.meta.env.BASE_URL;
const month = (date: string) => new Date(`${date.length === 7 ? date + '-01' : date}T12:00:00Z`).toLocaleDateString('en-US', {month: 'short', year: 'numeric', timeZone: 'UTC'});
---
<Layout>
  <SiteHeader page="main" />

  <main id="main" class="page-shell">
    <section class="introduction" aria-labelledby="name">
      <div class="intro-copy">
        <h1 id="name">Ji Woong Kim<span class="alternate-name">(Brian)</span></h1>
        <!-- Preserve the author's original introduction; do not rewrite it during layout changes. -->
        <div class="biography">
          <p>I am a postdoc at <a href="https://www.stanford.edu/" target="_blank" rel="noreferrer">Stanford University</a> advised by <a href="https://ai.stanford.edu/~cbfinn/" target="_blank" rel="noreferrer">Chelsea Finn</a>. I am broadly interested in building general-purpose robots that can perform any tasks in the real-world, ranging from surgical to humanoid applications.</p>
          <p>Previously, I focused on developing dextrous manipulation policies for the da Vinci robot with <a href="https://engineering.jhu.edu/faculty/axel-krieger/" target="_blank" rel="noreferrer">Axel Krieger</a>. I also worked on developing autonomous surgical workflows for eye surgery with <a href="https://me.jhu.edu/faculty/marin-kobilarov/" target="_blank" rel="noreferrer">Marin Kobilarov</a> and <a href="https://engineering.jhu.edu/faculty/iulian-iordachita/" target="_blank" rel="noreferrer">Iulian Iordachita</a>. I interned at Zoox (self-driving company owned by Amazon) in the planning &amp; controls and prediction team.</p>
        </div>
        <div class="profile-links" aria-label="Contact and academic profiles">
          <a href={profile.cv} target="_blank" rel="noreferrer"><ProfileIcon name="cv" />CV</a>
          <a href={profile.scholar} target="_blank" rel="noreferrer"><ProfileIcon name="scholar" />Google Scholar</a>
          <a href="https://www.linkedin.com/in/jkim447/" target="_blank" rel="noreferrer"><ProfileIcon name="linkedin" />LinkedIn</a>
          <a href="https://x.com/jwbkim" target="_blank" rel="noreferrer"><ProfileIcon name="x" />X</a>
        </div>
        <p class="profile-email">{profile.email}</p>
      </div>
      <figure class="portrait">
        <img src={`${base}media/portrait.webp`} width="347" height="450" alt="Ji Woong (Brian) Kim" fetchpriority="high" />
      </figure>
      <aside class="opportunity">
        <time class="opportunity-date" datetime="2026-09">September 2026</time>
        <p>I’m looking for graduate students and PhD visitors to work with me. Email me if interested!</p>
      </aside>
    </section>

    <section class="section-grid news-section" aria-labelledby="news-title">
      <div class="section-content">
        <div class="section-heading"><h2 id="news-title">News</h2><button type="button" class="text-button news-expand" aria-expanded="false" aria-controls="news-list" data-news-expand>Expand all <Icon name="chevron" size={14} /></button></div>
        <div class="news-window" data-news-window>
          <div class="news-scroll" id="news-list" tabindex="0" role="region" aria-label="Latest news, scroll for older updates">
            <ol class="news-list">
              {news.map(item => <li class="news-item"><time datetime={item.date}>{month(item.date)}</time><p>{item.upcoming && <span class="upcoming">Upcoming</span>}{item.content.map(part => typeof part === 'string' ? part : <a href={part.url} target="_blank" rel="noreferrer">{part.text}</a>)}</p></li>)}
            </ol>
          </div>
        </div>
        <p class="scroll-hint" data-scroll-hint>Scroll for earlier updates <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="section-grid research-section" id="research" aria-labelledby="research-title">
      <div class="section-content">
        <div class="section-heading"><h2 id="research-title">Selected work</h2></div>
        <div class="research-features">{projects.map(project => <ResearchFeature project={project} />)}</div>
      </div>
    </section>

    <section class="section-grid publications-section" id="publications" aria-labelledby="publications-title">
      <div class="section-content">
        <div class="section-heading"><h2 id="publications-title">Publications</h2><a class="subtle-link" href={profile.scholar} target="_blank" rel="noreferrer">Google Scholar <Icon name="external" size={14} /></a></div>
        <div class="publication-toolbar" data-publication-toolbar hidden>
          <div class="publication-filters" role="group" aria-label="Filter publications by type">
            <button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">All <span>{publications.length}</span></button>
            <button type="button" class="filter-button" data-filter="journal" aria-pressed="false">Journals</button>
            <button type="button" class="filter-button" data-filter="conference" aria-pressed="false">Conferences</button>
            <button type="button" class="filter-button" data-filter="preprint" aria-pressed="false">Preprints & reports</button>
          </div>
          <div class="publication-search"><Icon name="search" size={15} /><label class="sr-only" for="publication-search">Search publications by title, author, venue, or year</label><input id="publication-search" type="search" placeholder="Search publications" autocomplete="off" /></div>
        </div>
        <p class="sr-only" id="publication-status" role="status" aria-live="polite">{publications.length} publications</p>
        <div class="publication-list">
          {publications.map(p => (
            <article class="publication" id={`pub-${p.id}`} data-type={p.type} data-search={`${p.title} ${p.authors} ${p.venue} ${p.year}`.toLocaleLowerCase()}>
              <h3>{p.links?.[0] ? <a href={p.links[0].url} target="_blank" rel="noreferrer">{p.title}</a> : p.title}</h3>
              <p class="publication-authors">{p.authors.split(/(Ji Woong Kim)/g).map(part => part === 'Ji Woong Kim' ? <strong>{part}</strong> : part)}</p>
              <div class="publication-details">
                <span class="publication-venue">{p.venue} · {p.year}</span>
                {p.note && <span class="publication-note">{p.note}</span>}
                {p.links?.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label} <Icon name="external" size={11} /></a>)}
              </div>
            </article>
          ))}
        </div>
        <div class="publication-empty" data-publication-empty hidden><p>No publications match this search.</p><button type="button" class="text-button" data-reset-search>Clear filters <Icon name="arrow" size={14} /></button></div>
      </div>
    </section>

    <VisitorStats />

  </main>

  <script src="../scripts/site.ts"></script>
</Layout>
